APP_NAME="Flight Ticket Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Colombo
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flight_tickets
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Ticket emails (see README "Emailing tickets to customers").
# MAIL_MAILER=log writes messages to storage/logs/laravel.log instead of sending (safe for development).
# For real sending use SMTP, e.g. MAIL_MAILER=smtp, MAIL_SCHEME=smtp (STARTTLS, port 587) or smtps (port 465),
# MAIL_HOST=smtp.your-provider.com, MAIL_USERNAME=..., MAIL_PASSWORD=... (never commit real credentials).
# MAIL_FROM_ADDRESS must be an address your provider allows you to send from (verified domain).
TICKET_EMAIL_MAX_MB=18
TICKET_EMAIL_MAX_FILE_MB=10
TICKET_EMAIL_QUEUE=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# React app origin(s) allowed by CORS (comma separated)
FRONTEND_URL=http://localhost:5173
TOKEN_EXPIRATION_HOURS=12

# First owner account created by `php artisan db:seed` (leave OWNER_PASSWORD empty to generate a strong one)
OWNER_NAME="Agency Owner"
OWNER_EMAIL=owner@agency.test
OWNER_PASSWORD=12345
